# --- WebUntis ------------------------------------------------------------
# Classic login (username + password), never exposed to the frontend.
WEBUNTIS_SERVER=htl-saalfelden.webuntis.com
WEBUNTIS_SCHOOL=htl-saalfelden
WEBUNTIS_USERNAME=
WEBUNTIS_PASSWORD=

# --- Microsoft Graph / Teams ----------------------------------------------
# Azure AD App Registration (free, portal.azure.com):
#   1. App registrations -> New registration
#      - Supported account types: this org only (or as your school allows)
#      - Redirect URI (Web): https://<your-domain>/api/graph/callback
#   2. API permissions -> Microsoft Graph -> Delegated:
#      ChannelMessage.Read.All, Files.Read.All, Team.ReadBasic.All,
#      Channel.ReadBasic.All, offline_access
#      (grant admin consent if your tenant requires it for these scopes)
#   3. Certificates & secrets -> New client secret -> copy the value below
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/graph/callback

# If your school blocks student-account OAuth consent entirely, leave these
# unset — the app degrades to "no Teams content" and the UI explains the
# photo-upload fallback isn't built yet (manual notes still work).

# --- Anthropic (learning plan generation) ---------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Storage ---------------------------------------------------------------
# Vercel Marketplace -> Redis (Upstash) integration sets these automatically.
# Without them the app falls back to a local JSON file in .data/ (dev only,
# NOT durable on Vercel's serverless filesystem).
KV_REST_API_URL=
KV_REST_API_TOKEN=
